/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Static crawler files must keep their own types. Pages serves an existing
# file before the single-page fallback, so these paths are not rewritten to /.
/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# App, login, and account URLs on this host are not marketing pages.
# Leave them crawlable in robots.txt so Google can see this header.
/login
  X-Robots-Tag: noindex, nofollow
/login/*
  X-Robots-Tag: noindex, nofollow
/signup
  X-Robots-Tag: noindex, nofollow
/signup/*
  X-Robots-Tag: noindex, nofollow
/app
  X-Robots-Tag: noindex, nofollow
/app/*
  X-Robots-Tag: noindex, nofollow
/account
  X-Robots-Tag: noindex, nofollow
/account/*
  X-Robots-Tag: noindex, nofollow
/dashboard
  X-Robots-Tag: noindex, nofollow
/dashboard/*
  X-Robots-Tag: noindex, nofollow
